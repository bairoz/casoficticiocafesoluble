<mxfile host="app.diagrams.net" version="24.7.17">
  <diagram id="recorridoA" name="Recorrido A - Consulta exitosa (200 OK)">
    <mxGraphModel dx="1400" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="Atitle" value="&lt;b&gt;Recorrido A — Consulta exitosa:&lt;/b&gt; GET /api/productos/3 → 200 OK" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontColor=#2D7600;" vertex="1" parent="1"><mxGeometry x="300" y="25" width="1180" height="40" as="geometry"/></mxCell>
        <mxCell id="Abox" value="&lt;b&gt;Aplicación Spring Boot&lt;/b&gt;&lt;br&gt;Tomcat embebido — puerto 8080" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;fontSize=13;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="300" y="90" width="1180" height="520" as="geometry"/></mxCell>
        <mxCell id="Acli" value="&lt;b&gt;Cliente / Postman&lt;/b&gt;&lt;br&gt;&lt;br&gt;Envía la petición HTTP&lt;br&gt;y recibe la respuesta" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="290" width="200" height="120" as="geometry"/></mxCell>
        <mxCell id="Aside" value="&lt;b&gt;Cuerpo JSON devuelto&lt;/b&gt;&lt;br&gt;&lt;br&gt;{ &quot;id&quot;: 3,&lt;br&gt;&amp;nbsp; &quot;nombre&quot;: &quot;Café Descafeinado&quot;,&lt;br&gt;&amp;nbsp; &quot;presentacion&quot;: &quot;100 g&quot;,&lt;br&gt;&amp;nbsp; &quot;categoria&quot;: &quot;Café soluble&quot;,&lt;br&gt;&amp;nbsp; &quot;disponible&quot;: false }" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;dashed=1;align=left;fontSize=10;fontFamily=Courier New;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="30" y="470" width="250" height="140" as="geometry"/></mxCell>
        <mxCell id="Adisp" value="&lt;b&gt;DispatcherServlet&lt;/b&gt;&lt;br&gt;&lt;br&gt;Front Controller de Spring:&lt;br&gt;recibe TODA petición y la enruta" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="340" y="170" width="220" height="100" as="geometry"/></mxCell>
        <mxCell id="Actrl" value="&lt;b&gt;ProductoController&lt;/b&gt;&lt;br&gt;@RestController&lt;br&gt;@RequestMapping(&quot;/api/productos&quot;)&lt;br&gt;@GetMapping(&quot;/{id}&quot;)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="720" y="170" width="240" height="100" as="geometry"/></mxCell>
        <mxCell id="Amem" value="&lt;b&gt;Productos en memoria&lt;/b&gt;&lt;br&gt;List&amp;lt;Producto&amp;gt; = ArrayList&lt;br&gt;&lt;br&gt;8 productos precargados&lt;br&gt;(sin base de datos)" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1160" y="160" width="220" height="125" as="geometry"/></mxCell>
        <mxCell id="Ajack" value="&lt;b&gt;Jackson (ObjectMapper)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Convierte el objeto Java&lt;br&gt;Producto → JSON" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="720" y="430" width="240" height="100" as="geometry"/></mxCell>
        <mxCell id="Aresp" value="&lt;b&gt;HTTP Response&lt;/b&gt;&lt;br&gt;&lt;b style=&quot;color:#2D7600&quot;&gt;200 OK&lt;/b&gt;&lt;br&gt;Content-Type: application/json&lt;br&gt;+ cuerpo JSON" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="340" y="430" width="220" height="100" as="geometry"/></mxCell>
        <mxCell id="Anota" value="&lt;b&gt;Clave del recorrido A:&lt;/b&gt; el producto SÍ existe en memoria, por lo tanto hay un objeto Java que serializar. Jackson se ejecuta y la respuesta viaja con cuerpo JSON y código 200." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;rounded=1;spacing=8;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="300" y="640" width="1180" height="60" as="geometry"/></mxCell>
        <mxCell id="Ae1" value="&lt;b&gt;1&lt;/b&gt; HTTP Request&lt;br&gt;GET /api/productos/3" style="labelBackgroundColor=#FFFFFF;fontSize=10;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#2D7600;exitX=1;exitY=0.25;entryX=0;entryY=0.5;" edge="1" parent="1" source="Acli" target="Adisp"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" x="0" y="-12"/></mxGeometry></mxCell>
        <mxCell id="Ae2" value="&lt;b&gt;2&lt;/b&gt; Enruta al método que coincide&lt;br&gt;@PathVariable Long id = 3" style="labelBackgroundColor=#FFFFFF;fontSize=10;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#2D7600;exitX=1;exitY=0.4;entryX=0;entryY=0.4;" edge="1" parent="1" source="Adisp" target="Actrl"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" x="0" y="-14"/></mxGeometry></mxCell>
        <mxCell id="Ae3" value="&lt;b&gt;3&lt;/b&gt; Busca el id 3&lt;br&gt;en la lista" style="labelBackgroundColor=#FFFFFF;fontSize=10;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#2D7600;exitX=1;exitY=0.3;entryX=0;entryY=0.35;" edge="1" parent="1" source="Actrl" target="Amem"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" x="0" y="-14"/></mxGeometry></mxCell>
        <mxCell id="Ae4" value="&lt;b&gt;4&lt;/b&gt; Lo encuentra: devuelve el&lt;br&gt;&lt;b&gt;objeto Java Producto&lt;/b&gt;" style="labelBackgroundColor=#FFFFFF;fontSize=10;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#2D7600;exitX=0;exitY=0.8;entryX=1;entryY=0.8;" edge="1" parent="1" source="Amem" target="Actrl"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" x="0" y="16"/></mxGeometry></mxCell>
        <mxCell id="Ae5" value="&lt;b&gt;5&lt;/b&gt; ResponseEntity.ok(producto)&lt;br&gt;entrega el objeto a Jackson" style="labelBackgroundColor=#FFFFFF;fontSize=10;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#2D7600;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="Actrl" target="Ajack"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" x="0" y="0"/></mxGeometry></mxCell>
        <mxCell id="Ae6" value="&lt;b&gt;6&lt;/b&gt; Serializa a JSON y lo&lt;br&gt;escribe en el cuerpo" style="labelBackgroundColor=#FFFFFF;fontSize=10;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#2D7600;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="Ajack" target="Aresp"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" x="0" y="-14"/></mxGeometry></mxCell>
        <mxCell id="Ae7" value="&lt;b&gt;7&lt;/b&gt; Respuesta HTTP&lt;br&gt;&lt;b style=&quot;color:#2D7600&quot;&gt;200 OK&lt;/b&gt; + JSON del producto" style="labelBackgroundColor=#FFFFFF;fontSize=10;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#2D7600;exitX=0;exitY=0.4;entryX=1;entryY=0.8;" edge="1" parent="1" source="Aresp" target="Acli"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" x="0" y="-14"/></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="recorridoB" name="Recorrido B - Producto inexistente (404)">
    <mxGraphModel dx="1400" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="Btitle" value="&lt;b&gt;Recorrido B — Recurso inexistente:&lt;/b&gt; GET /api/productos/999 → 404 Not Found" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontColor=#B85450;" vertex="1" parent="1"><mxGeometry x="300" y="25" width="1180" height="40" as="geometry"/></mxCell>
        <mxCell id="Bbox" value="&lt;b&gt;Aplicación Spring Boot&lt;/b&gt;&lt;br&gt;Tomcat embebido — puerto 8080" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;fontSize=13;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="300" y="90" width="1180" height="520" as="geometry"/></mxCell>
        <mxCell id="Bcli" value="&lt;b&gt;Cliente / Postman&lt;/b&gt;&lt;br&gt;&lt;br&gt;Envía la petición HTTP&lt;br&gt;y recibe la respuesta" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="290" width="200" height="120" as="geometry"/></mxCell>
        <mxCell id="Bside" value="&lt;b&gt;Cuerpo de la respuesta&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;(vacío)&lt;/i&gt;&lt;br&gt;&lt;br&gt;El 404 no lleva cuerpo:&lt;br&gt;no hubo objeto que convertir." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;dashed=1;align=left;fontSize=10;fontFamily=Courier New;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="30" y="470" width="250" height="140" as="geometry"/></mxCell>
        <mxCell id="Bdisp" value="&lt;b&gt;DispatcherServlet&lt;/b&gt;&lt;br&gt;&lt;br&gt;Front Controller de Spring:&lt;br&gt;recibe TODA petición y la enruta" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="340" y="170" width="220" height="100" as="geometry"/></mxCell>
        <mxCell id="Bctrl" value="&lt;b&gt;ProductoController&lt;/b&gt;&lt;br&gt;@RestController&lt;br&gt;@RequestMapping(&quot;/api/productos&quot;)&lt;br&gt;@GetMapping(&quot;/{id}&quot;)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="720" y="170" width="240" height="100" as="geometry"/></mxCell>
        <mxCell id="Bmem" value="&lt;b&gt;Productos en memoria&lt;/b&gt;&lt;br&gt;List&amp;lt;Producto&amp;gt; = ArrayList&lt;br&gt;&lt;br&gt;IDs existentes: 1 a 8&lt;br&gt;&lt;b style=&quot;color:#B85450&quot;&gt;el 999 NO está&lt;/b&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1160" y="160" width="220" height="125" as="geometry"/></mxCell>
        <mxCell id="Bjack" value="&lt;b&gt;Jackson (ObjectMapper)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;NO se ejecuta&lt;/i&gt;&lt;br&gt;&lt;i&gt;no hay objeto que serializar&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b3b3b3;fontColor=#999999;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="720" y="430" width="240" height="100" as="geometry"/></mxCell>
        <mxCell id="Bresp" value="&lt;b&gt;HTTP Response&lt;/b&gt;&lt;br&gt;&lt;b style=&quot;color:#B85450&quot;&gt;404 Not Found&lt;/b&gt;&lt;br&gt;&lt;b&gt;sin cuerpo&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="340" y="430" width="220" height="100" as="geometry"/></mxCell>
        <mxCell id="Bnota" value="&lt;b&gt;Clave del recorrido B:&lt;/b&gt; la petición recorre EXACTAMENTE el mismo camino hasta el controlador. Lo que cambia es que la búsqueda no devuelve ningún objeto: Jackson nunca se invoca y la respuesta viaja sin cuerpo, solo con el código 404." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;spacing=8;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="300" y="640" width="1180" height="60" as="geometry"/></mxCell>
        <mxCell id="Be1" value="&lt;b&gt;1&lt;/b&gt; HTTP Request&lt;br&gt;GET /api/productos/999" style="labelBackgroundColor=#FFFFFF;fontSize=10;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#B85450;exitX=1;exitY=0.25;entryX=0;entryY=0.5;" edge="1" parent="1" source="Bcli" target="Bdisp"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" x="0" y="-12"/></mxGeometry></mxCell>
        <mxCell id="Be2" value="&lt;b&gt;2&lt;/b&gt; Enruta al método que coincide&lt;br&gt;@PathVariable Long id = 999" style="labelBackgroundColor=#FFFFFF;fontSize=10;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#B85450;exitX=1;exitY=0.4;entryX=0;entryY=0.4;" edge="1" parent="1" source="Bdisp" target="Bctrl"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" x="0" y="-14"/></mxGeometry></mxCell>
        <mxCell id="Be3" value="&lt;b&gt;3&lt;/b&gt; Busca el id 999&lt;br&gt;en la lista" style="labelBackgroundColor=#FFFFFF;fontSize=10;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#B85450;exitX=1;exitY=0.3;entryX=0;entryY=0.35;" edge="1" parent="1" source="Bctrl" target="Bmem"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" x="0" y="-14"/></mxGeometry></mxCell>
        <mxCell id="Be4" value="&lt;b&gt;4&lt;/b&gt; &lt;b style=&quot;color:#B85450&quot;&gt;NO lo encuentra&lt;/b&gt;&lt;br&gt;no se obtiene ningún objeto Java" style="labelBackgroundColor=#FFFFFF;fontSize=10;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#B85450;exitX=0;exitY=0.8;entryX=1;entryY=0.8;dashed=1;" edge="1" parent="1" source="Bmem" target="Bctrl"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" x="0" y="16"/></mxGeometry></mxCell>
        <mxCell id="Be5" value="&lt;b&gt;5&lt;/b&gt; ResponseEntity.notFound().build()&lt;br&gt;&lt;b&gt;se salta a Jackson:&lt;/b&gt; no hay nada que convertir" style="labelBackgroundColor=#FFFFFF;fontSize=10;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#B85450;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeWidth=3;" edge="1" parent="1" source="Bctrl" target="Bresp"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" x="0" y="0"/></mxGeometry></mxCell>
        <mxCell id="Be6" value="&lt;b&gt;6&lt;/b&gt; Respuesta HTTP&lt;br&gt;&lt;b style=&quot;color:#B85450&quot;&gt;404 Not Found&lt;/b&gt; sin cuerpo" style="labelBackgroundColor=#FFFFFF;fontSize=10;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#B85450;exitX=0;exitY=0.4;entryX=1;entryY=0.8;" edge="1" parent="1" source="Bresp" target="Bcli"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" x="0" y="-14"/></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
